[sub_resource type="RectangleShape2D" id="RectangleShape2D_npwx6"]

[sub_resource type="GDScript" id="GDScript_wtly1"]
script/source = "extends Camera2D

@export var camera_move_speed: float = 400.0
@export var camera_smoothing: float = 8.0

@export var max_horizontal_offset: float = 500.0
@export var max_vertical_offset: float = 300.0

var target_offset := Vector2.ZERO


func _process(delta: float) -> void:

	# --------------------------------------------------
	# CAMERA MOVEMENT
	# --------------------------------------------------

	var direction := Vector2.ZERO

	if Input.is_action_pressed(\"camera_left\"):
		direction.x -= 1

	if Input.is_action_pressed(\"camera_right\"):
		direction.x += 1

	if Input.is_action_pressed(\"camera_up\"):
		direction.y -= 1

	if Input.is_action_pressed(\"camera_down\"):
		direction.y += 1


	# Move the desired camera offset.
	target_offset += direction * camera_move_speed * delta


	# Keep the camera within its allowed range.
	target_offset.x = clamp(
		target_offset.x,
		-max_horizontal_offset,
		max_horizontal_offset
	)

	target_offset.y = clamp(
		target_offset.y,
		-max_vertical_offset,
		max_vertical_offset
	)


	# Smoothly move toward the target.
	position = position.lerp(
		target_offset,
		1.0 - exp(-camera_smoothing * delta)
	)
"

